{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "The local app shell (toolbar + column headers): manages columns.",
  "windows": ["main"],
  "webviews": ["shell"],
  "permissions": [
    "core:default",
    "allow-load-columns",
    "allow-save-columns",
    "allow-column-open",
    "allow-column-close",
    "allow-column-set-bounds",
    "allow-column-navigate",
    "allow-column-reload",
    "allow-column-go-back",
    "allow-column-run",
    "allow-column-focus-emulation",
    "allow-column-press-period",
    "allow-open-compose"
  ]
}
